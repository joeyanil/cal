{
  "name": "k2-calendar-engine",
  "version": "0.1.0",
  "private": true,
  "description": "K2 Academic Calendar Engine \u2014 first-class TypeScript/Next.js subsystem of the K2 school platform, skinned in K2's locked Admin design system (20_Design_System.md).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:integration": "vitest run --config tests-integration/vitest.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.1",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.50.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "kenat": "4.0.0",
    "lucide-react": "0.446.0",
    "next": "15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.23.8"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "20.16.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.11",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.6.2",
    "vitest": "2.1.9",
    "wrangler": "^4.136.1"
  }
}
